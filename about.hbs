<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CurveBook — Third-Party Software Licenses</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #ffffff;
      --fg: #1b2230;
      --muted: #526075;
      --border: #d7dee8;
      --surface: #f5f8fc;
      --accent: #1b2d56;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.55;
      color: var(--fg);
      background: var(--bg);
      margin: 2rem auto;
      max-width: 960px;
      padding: 0 1.25rem;
    }
    h1, h2, h3 { color: var(--accent); }
    h1 { border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; }
    .overview {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      list-style: none;
      padding: 0;
      margin: 1rem 0 2rem;
    }
    .overview li {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.35rem 0.75rem;
      font-size: 0.92rem;
    }
    .overview a { color: var(--accent); text-decoration: none; font-weight: 600; }
    .license-block {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem 1.25rem;
      margin-bottom: 1.5rem;
      background: #ffffff;
    }
    .used-by { margin: 0.5rem 0 1rem; padding-left: 1.25rem; }
    .used-by li { margin: 0.2rem 0; color: var(--muted); }
    .used-by a { color: var(--accent); }
    pre.license-text {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.9rem;
      overflow-x: auto;
      white-space: pre-wrap;
      font-size: 0.84rem;
      line-height: 1.45;
    }
  </style>
</head>
<body>
  <header>
    <h1>CurveBook — Third-Party Software Licenses</h1>
    <p>This document lists third-party Rust crates used in CurveBook releases and their applicable software licenses.</p>
  </header>

  <section aria-label="License overview">
    <h2>Overview</h2>
    <ul class="overview">
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>
  </section>

  <main>
    <h2>Licenses</h2>
    {{#each licenses}}
    <section class="license-block" id="{{id}}">
      <h3>{{name}} ({{id}})</h3>
      <ul class="used-by">
        {{#each used_by}}
        <li>
          {{#if crate.repository}}
          <a href="{{crate.repository}}">{{crate.name}} {{crate.version}}</a>
          {{else}}
          <span>{{crate.name}} {{crate.version}}</span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      <pre class="license-text">{{text}}</pre>
    </section>
    {{/each}}
  </main>
</body>
</html>
