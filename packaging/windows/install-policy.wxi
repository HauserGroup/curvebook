<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Property Id="INSTALLFOLDER" Secure="yes" />
  <Property Id="CURVEBOOK_SCOPE" Value="user" Secure="yes" />
  <Property Id="CURVEBOOK_U_DIR" Secure="yes"><RegistrySearch Id="CURVEBOOK_U_DIRSearch" Root="HKCU" Key="Software\CurveBook" Name="InstallDir" Type="raw" /></Property>
  <SetProperty Id="CURVEBOOK_USER_DIR" Action="CurveBookUFromDIR" Value="[CURVEBOOK_U_DIR]" After="AppSearch" Sequence="both" Condition="NOT CURVEBOOK_USER_DIR AND CURVEBOOK_U_DIR" />
  <Property Id="CURVEBOOK_U_FOLDER" Secure="yes"><RegistrySearch Id="CURVEBOOK_U_FOLDERSearch" Root="HKCU" Key="Software\CurveBook" Name="InstallFolder" Type="raw" /></Property>
  <SetProperty Id="CURVEBOOK_USER_DIR" Action="CurveBookUFromFOLDER" Value="[CURVEBOOK_U_FOLDER]" After="CurveBookUFromDIR" Sequence="both" Condition="NOT CURVEBOOK_USER_DIR AND CURVEBOOK_U_FOLDER" />
  <Property Id="CURVEBOOK_U_PATH" Secure="yes"><RegistrySearch Id="CURVEBOOK_U_PATHSearch" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\curvebook.exe" Name="Path" Type="raw" /></Property>
  <SetProperty Id="CURVEBOOK_USER_DIR" Action="CurveBookUFromPATH" Value="[CURVEBOOK_U_PATH]" After="CurveBookUFromFOLDER" Sequence="both" Condition="NOT CURVEBOOK_USER_DIR AND CURVEBOOK_U_PATH" />
  <Property Id="CURVEBOOK_U_EXEFOLDER" Secure="yes"><RegistrySearch Id="CURVEBOOK_ULegacyFolder" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\curvebook.exe" Type="file" /></Property>
  <Property Id="CURVEBOOK_U_EXE" Secure="yes"><RegistrySearch Id="CURVEBOOK_ULegacyExe" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\curvebook.exe" Type="file"><FileSearch Id="CURVEBOOK_ULegacyFile" Name="curvebook.exe" /></RegistrySearch></Property>
  <SetProperty Id="CURVEBOOK_USER_DIR" Action="CurveBookUFromLegacyExe" Value="[CURVEBOOK_U_EXEFOLDER]" After="CurveBookUFromPATH" Sequence="both" Condition="NOT CURVEBOOK_USER_DIR AND CURVEBOOK_U_EXEFOLDER AND CURVEBOOK_U_EXE" />
  <Property Id="CURVEBOOK_USER_DIR" Secure="yes" />
  <Property Id="CURVEBOOK_M_DIR" Secure="yes"><RegistrySearch Id="CURVEBOOK_M_DIRSearch" Root="HKLM" Key="Software\CurveBook" Name="InstallDir" Type="raw" /></Property>
  <SetProperty Id="CURVEBOOK_MACHINE_DIR" Action="CurveBookMFromDIR" Value="[CURVEBOOK_M_DIR]" After="CurveBookUFromLegacyExe" Sequence="both" Condition="NOT CURVEBOOK_MACHINE_DIR AND CURVEBOOK_M_DIR" />
  <Property Id="CURVEBOOK_M_FOLDER" Secure="yes"><RegistrySearch Id="CURVEBOOK_M_FOLDERSearch" Root="HKLM" Key="Software\CurveBook" Name="InstallFolder" Type="raw" /></Property>
  <SetProperty Id="CURVEBOOK_MACHINE_DIR" Action="CurveBookMFromFOLDER" Value="[CURVEBOOK_M_FOLDER]" After="CurveBookMFromDIR" Sequence="both" Condition="NOT CURVEBOOK_MACHINE_DIR AND CURVEBOOK_M_FOLDER" />
  <Property Id="CURVEBOOK_M_PATH" Secure="yes"><RegistrySearch Id="CURVEBOOK_M_PATHSearch" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\curvebook.exe" Name="Path" Type="raw" /></Property>
  <SetProperty Id="CURVEBOOK_MACHINE_DIR" Action="CurveBookMFromPATH" Value="[CURVEBOOK_M_PATH]" After="CurveBookMFromFOLDER" Sequence="both" Condition="NOT CURVEBOOK_MACHINE_DIR AND CURVEBOOK_M_PATH" />
  <Property Id="CURVEBOOK_M_EXEFOLDER" Secure="yes"><RegistrySearch Id="CURVEBOOK_MLegacyFolder" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\curvebook.exe" Type="file" /></Property>
  <Property Id="CURVEBOOK_M_EXE" Secure="yes"><RegistrySearch Id="CURVEBOOK_MLegacyExe" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\curvebook.exe" Type="file"><FileSearch Id="CURVEBOOK_MLegacyFile" Name="curvebook.exe" /></RegistrySearch></Property>
  <SetProperty Id="CURVEBOOK_MACHINE_DIR" Action="CurveBookMFromLegacyExe" Value="[CURVEBOOK_M_EXEFOLDER]" After="CurveBookMFromPATH" Sequence="both" Condition="NOT CURVEBOOK_MACHINE_DIR AND CURVEBOOK_M_EXEFOLDER AND CURVEBOOK_M_EXE" />
  <Property Id="CURVEBOOK_MACHINE_DIR" Secure="yes" />
  <SetProperty Id="CURVEBOOK_SCOPE" Action="CurveBookPreferMachineScope" Value="machine" After="CurveBookMFromLegacyExe" Sequence="ui" Condition="ALLUSERS = 1 OR (CURVEBOOK_MACHINE_DIR AND NOT CURVEBOOK_USER_DIR)" />
  <SetProperty Id="INSTALLFOLDER" Action="CurveBookRestoreUserFolder" Value="[CURVEBOOK_USER_DIR]" Before="CostInitialize" Sequence="both" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1 AND CURVEBOOK_USER_DIR" />
  <?if $(sys.BUILDARCH) = x86 ?>
  <SetProperty Id="INSTALLFOLDER" Action="CurveBookDefaultMachineFolder" Value="[%ProgramFiles(x86)]\CurveBook\" After="CurveBookRestoreUserFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND VersionNT64" />
  <SetProperty Id="INSTALLFOLDER" Action="CurveBookDefaultMachineFolder32" Value="[%ProgramFiles]\CurveBook\" After="CurveBookDefaultMachineFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND NOT VersionNT64" />
  <SetProperty Id="INSTALLFOLDER" Action="CurveBookDefaultUserFolder" Value="[LocalAppDataFolder]Programs\CurveBook\" After="CurveBookDefaultMachineFolder32" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1" />
  <?else?>
  <SetProperty Id="INSTALLFOLDER" Action="CurveBookDefaultMachineFolder" Value="[%ProgramW6432]\CurveBook\" After="CurveBookRestoreUserFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1" />
  <SetProperty Id="INSTALLFOLDER" Action="CurveBookDefaultUserFolder" Value="[LocalAppDataFolder]Programs\CurveBook\" After="CurveBookDefaultMachineFolder" Sequence="ui" Condition="NOT INSTALLFOLDER AND ALLUSERS &lt;&gt; 1" />
  <?endif?>
  <SetProperty Id="INSTALLFOLDER" Action="CurveBookRestoreMachineFolder" Value="[CURVEBOOK_MACHINE_DIR]" Before="CurveBookRestoreUserFolder" Sequence="both" Condition="NOT INSTALLFOLDER AND ALLUSERS = 1 AND CURVEBOOK_MACHINE_DIR" />
  <Launch Condition="Installed OR ALLUSERS &lt;&gt; 1 OR NOT CURVEBOOK_USER_DIR" Message="This app is already installed for your account. Choose Only for me to update it, or uninstall that copy before changing who it is installed for." />
  <Launch Condition="Installed OR ALLUSERS = 1 OR NOT CURVEBOOK_MACHINE_DIR" Message="This app is already installed for everyone. Choose Everyone to update it, or pass ALLUSERS=1 to msiexec. Uninstall that copy before changing who it is installed for." />
  <UI>
    <TextStyle Id="CurveBookScopeText" FaceName="Segoe UI" Size="9" />
    <TextStyle Id="CurveBookScopeTitle" FaceName="Segoe UI" Size="12" Bold="yes" />
    <Dialog Id="CurveBookScopeDlg" Width="370" Height="220" Title="[ProductName] Setup" NoMinimize="yes">
      <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="30" Text="{\CurveBookScopeTitle}Who should use [ProductName]?" />
      <Control Id="Info" Type="Text" X="20" Y="50" Width="330" Height="30" Text="{\CurveBookScopeText}An update keeps the existing folder. New copies install to CurveBook under Programs." />
      <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="88" Width="330" Height="60" Property="CURVEBOOK_SCOPE">
        <RadioButtonGroup Property="CURVEBOOK_SCOPE">
          <RadioButton Value="user" X="0" Y="0" Width="330" Height="20" Text="Only for me (no administrator permission needed)" />
          <RadioButton Value="machine" X="0" Y="30" Width="330" Height="20" Text="Everyone on this computer (asks an administrator)" />
        </RadioButtonGroup>
      </Control>
      <Control Id="Next" Type="PushButton" X="214" Y="182" Width="66" Height="20" Default="yes" Text="Next">
        <Publish Property="ALLUSERS" Value="1" Order="1" Condition="CURVEBOOK_SCOPE = &quot;machine&quot;" />
        <Publish Property="ALLUSERS" Value="{}" Order="2" Condition="CURVEBOOK_SCOPE = &quot;user&quot;" />
        <Publish Property="MSIINSTALLPERUSER" Value="{}" Order="3" Condition="CURVEBOOK_SCOPE = &quot;machine&quot;" />
        <Publish Property="MSIINSTALLPERUSER" Value="1" Order="4" Condition="CURVEBOOK_SCOPE = &quot;user&quot;" />
        <Publish Event="EndDialog" Value="Return" Order="5" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="290" Y="182" Width="60" Height="20" Cancel="yes" Text="Cancel"><Publish Event="EndDialog" Value="Exit" /></Control>
    </Dialog>
  </UI>
  <InstallUISequence>
    <Show Dialog="CurveBookScopeDlg" After="CurveBookPreferMachineScope" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
    <FindRelatedProducts After="CurveBookScopeDlg" />
  </InstallUISequence>
</Include>
