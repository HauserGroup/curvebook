<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="CurveBook" Manufacturer="CurveBook Contributors" Version="$(var.Version)" UpgradeCode="570875D8-A8A5-4335-8646-C8CE385B27BD" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="CurveBook biostatistics and scientific graphing app" Manufacturer="CurveBook Contributors" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of CurveBook is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="CurveBookIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="CurveBookIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/HauserGroup/curvebook" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/HauserGroup/curvebook/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/HauserGroup/curvebook/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="CurveBook" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="CurveBook" Level="1">
      <ComponentGroupRef Id="CurveBookFiles" />
      <ComponentGroupRef Id="AppDocumentation" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="NOT Installed" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ShortcutsDlgTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ShortcutsDlgDescription)" />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="60" Width="330" Height="18" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="!(loc.ShortcutsDlgDesktop)" />
        <Control Id="StartMenuNote" Type="Text" X="20" Y="84" Width="330" Height="30" NoPrefix="yes" Text="!(loc.ShortcutsDlgStartMenu)" />
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchCurveBook" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <Property Id="CurveBookVersion" Value="$(var.DisplayVersion)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="CurveBook $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch CurveBook" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#CurveBookExe]" />
    <CustomAction Id="LaunchCurveBook" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppDocumentation" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <ComponentGroup Id="CurveBookFiles" Directory="INSTALLFOLDER">
      <Component Id="CurveBookApp" Guid="30074268-38AD-4435-82B7-E2E8948273F9">
        <File Id="CurveBookExe" Source="$(var.BinDir)\curvebook.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="CurveBook" Description="CurveBook biostatistics and scientific graphing app" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="CurveBookIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\curvebook.exe" Value="[#CurveBookExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\CurveBook" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />

        <ProgId Id="CurveBook.Project" Description="CurveBook Project" Icon="CurveBookIcon.ico" IconIndex="0">
          <Extension Id="curvebook" ContentType="application/vnd.curvebook.project">
            <Verb Id="open" Command="Open" TargetFile="CurveBookExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <ProgId Id="CurveBook.Template" Description="CurveBook Project Template" Icon="CurveBookIcon.ico" IconIndex="0">
          <Extension Id="cbtemplate" ContentType="application/vnd.curvebook.template">
            <Verb Id="open" Command="Open" TargetFile="CurveBookExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
      </Component>

      <Component Id="CurveBookCli">
        <File Id="CurveBookCliExe" Source="$(var.BinDir)\curvebook-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="5BFAC2A4-683C-40C9-B561-298D76308811" Condition="INSTALLDESKTOPSHORTCUT">
      <Shortcut Id="DesktopShortcut" Name="CurveBook" Description="CurveBook biostatistics and scientific graphing app" Target="[#CurveBookExe]" WorkingDirectory="INSTALLFOLDER" Icon="CurveBookIcon.ico" IconIndex="0" />
      <RegistryValue Root="HKMU" Key="Software\CurveBook" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
