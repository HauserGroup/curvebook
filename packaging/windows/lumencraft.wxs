<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="LumenCraft" Manufacturer="LumenCraft Contributors" Version="$(var.Version)" UpgradeCode="CC9EF573-33E0-4208-BE7A-690B34A5A4C9" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="LumenCraft biostatistics and scientific graphing app" Manufacturer="LumenCraft Contributors" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of LumenCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LumencraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LumencraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/lumencraft/lumencraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/lumencraft/lumencraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/lumencraft/lumencraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="LumenCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="LumenCraft" Level="1">
      <ComponentGroupRef Id="LumencraftFiles" />
      <ComponentGroupRef Id="AppDocumentation" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" Secure="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg" Order="5" Condition="NOT Installed" />

      <Dialog Id="ShortcutsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ShortcutsDlgTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ShortcutsDlgDescription)" />
        <Control Id="DesktopShortcutCheckBox" Type="CheckBox" X="20" Y="60" Width="330" Height="18" Property="INSTALLDESKTOPSHORTCUT" CheckBoxValue="1" Text="!(loc.ShortcutsDlgDesktop)" />
        <Control Id="StartMenuNote" Type="Text" X="20" Y="84" Width="330" Height="30" NoPrefix="yes" Text="!(loc.ShortcutsDlgStartMenu)" />
      </Dialog>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLumencraft" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <Property Id="LumencraftVersion" Value="$(var.DisplayVersion)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="LumenCraft $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch LumenCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LumencraftExe]" />
    <CustomAction Id="LaunchLumencraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppDocumentation" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <ComponentGroup Id="LumencraftFiles" Directory="INSTALLFOLDER">
      <Component Id="LumencraftApp" Guid="039825BB-45BE-41D1-BBAF-8D25A4125026">
        <File Id="LumencraftExe" Source="$(var.BinDir)\lumencraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="LumenCraft" Description="LumenCraft biostatistics and scientific graphing app" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="LumencraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\lumencraft.exe" Value="[#LumencraftExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\LumenCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="LumencraftCli">
        <File Id="LumencraftCliExe" Source="$(var.BinDir)\lumencraft-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="512791E8-A25F-40EC-82B4-500A4EE18F8F" Condition="INSTALLDESKTOPSHORTCUT">
      <Shortcut Id="DesktopShortcut" Name="LumenCraft" Description="LumenCraft biostatistics and scientific graphing app" Target="[#LumencraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="LumencraftIcon.ico" IconIndex="0" />
      <RegistryValue Root="HKMU" Key="Software\LumenCraft" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
