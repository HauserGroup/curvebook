{
  "$defs": {
    "AssetManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^img-[0-9a-f]{16}$",
          "type": "string"
        },
        "byte_len": {
          "maximum": 33554432,
          "minimum": 0,
          "type": "integer"
        },
        "crc32": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "$ref": "#/$defs/ImageMimeKind"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "media_type",
        "path",
        "byte_len",
        "crc32"
      ],
      "title": "AssetManifestEntry",
      "type": "object"
    },
    "ImageMimeKind": {
      "enum": [
        "Png",
        "Jpeg",
        "Tiff"
      ],
      "type": "string"
    },
    "SheetId": {
      "description": "Non-empty hook-safe sheet identifier (1..=256 bytes, no whitespace, control characters, `:`, `{{`, or `}}`).",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^(?!.*(?:\\{\\{|\\}\\}))[^\\s:\\x00-\\x1f\\x7f]{1,256}$",
      "title": "SheetId",
      "type": "string"
    },
    "SheetManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "crc32": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "csv_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/SheetId"
        },
        "section": {
          "$ref": "#/$defs/SheetSection"
        },
        "title": {
          "maxLength": 4096,
          "type": "string"
        }
      },
      "required": [
        "id",
        "section",
        "title",
        "csv_path",
        "crc32"
      ],
      "title": "SheetManifestEntry",
      "type": "object"
    },
    "SheetSection": {
      "enum": [
        "Data",
        "Info",
        "Analyses",
        "Graphs",
        "Layouts"
      ],
      "type": "string"
    }
  },
  "$id": "https://github.com/HauserGroup/curvebook/blob/main/docs/schemas/archive-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Draft 2020-12 schema for CurveBook .curvebook / .cbtemplate archive manifest.json files.",
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/AssetManifestEntry"
      },
      "type": "array"
    },
    "document_crc32": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "format": {
      "const": "curvebook-archive",
      "type": "string"
    },
    "kind": {
      "enum": [
        "Project",
        "Template"
      ],
      "type": "string"
    },
    "schema_version": {
      "maximum": 8,
      "minimum": 0,
      "type": "integer"
    },
    "sheets": {
      "items": {
        "$ref": "#/$defs/SheetManifestEntry"
      },
      "type": "array"
    },
    "title": {
      "maxLength": 4096,
      "type": "string"
    }
  },
  "required": [
    "format",
    "schema_version",
    "kind",
    "title",
    "document_crc32",
    "sheets"
  ],
  "title": "ArchiveManifest",
  "type": "object"
}
