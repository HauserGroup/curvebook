{
  "$defs": {
    "SheetId": {
      "description": "Non-whitespace sheet identifier (trimmed non-empty).",
      "minLength": 1,
      "pattern": "\\S",
      "title": "SheetId",
      "type": "string"
    },
    "SheetManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "crc32": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "csv_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/SheetId"
        },
        "section": {
          "$ref": "#/$defs/SheetSection"
        },
        "title": {
          "maxLength": 4096,
          "type": "string"
        }
      },
      "required": [
        "id",
        "section",
        "title",
        "csv_path",
        "crc32"
      ],
      "title": "SheetManifestEntry",
      "type": "object"
    },
    "SheetSection": {
      "enum": [
        "Data",
        "Info",
        "Analyses",
        "Graphs",
        "Layouts"
      ],
      "type": "string"
    }
  },
  "$id": "https://github.com/HauserGroup/curvebook/blob/main/docs/schemas/archive-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Draft 2020-12 schema for CurveBook .curvebook / .cbtemplate archive manifest.json files.",
  "properties": {
    "document_crc32": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "format": {
      "const": "curvebook-archive",
      "type": "string"
    },
    "kind": {
      "enum": [
        "Project",
        "Template"
      ],
      "type": "string"
    },
    "schema_version": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
    },
    "sheets": {
      "items": {
        "$ref": "#/$defs/SheetManifestEntry"
      },
      "type": "array"
    },
    "title": {
      "maxLength": 4096,
      "type": "string"
    }
  },
  "required": [
    "format",
    "schema_version",
    "kind",
    "title",
    "document_crc32",
    "sheets"
  ],
  "title": "ArchiveManifest",
  "type": "object"
}
